// ── COMPONENT ─────────────────────────────────────────────────────────────────
export default function MegetremiaAdventure() {
  const [phase, setPhase]     = useState("intro");    // intro|class|explore|combat|gameover|victory
  const [lines, setLines]     = useState([]);
  const [input, setInput]     = useState("");
  const [player, setPlayer]   = useState(null);
  const [room, setRoom]       = useState("entrance");
  const [visited, setVisited] = useState(new Set());
  const [combat, setCombat]   = useState(null);       // {enemy, enemyHp, round, stunned, advantage, perlinBonus}
  const [inventory, setInv]   = useState([]);
  const [flags, setFlags]     = useState({});         // cleared rooms, used keys, etc.
  const bottomRef = useRef(null);
  const inputRef  = useRef(null);

  const push = (...ls) => setLines(p => [...p, ...ls]);

  useEffect(() => {
    push(
      ``,
      `  ╔══════════════════════════════════════════════════════╗`,
      `  ║       MEGETREMIA — A TABLETOP ADVENTURE              ║`,
      `  ║       singularity-shell snapshot v0.9                ║`,
      `  ║       the root waits at the bottom of everything     ║`,
      `  ╚══════════════════════════════════════════════════════╝`,
      ``,
      `  Choose your class. Type the name to select.`,
      ``,
      ...Object.entries(CLASSES).map(([k,v]) =>
        `  ${k.padEnd(14)} — ${v.flavor}`
      ),
      ``,
      `  > _`,
    );
    setPhase("class");
  }, []);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [lines]);

  useEffect(() => { inputRef.current?.focus(); }, []);

  // ── HELPERS ────────────────────────────────────────────────────────────────
  const makePlayer = (cls) => ({
    class: cls.title,
    nature: cls.nature,
    hp: cls.hp, maxHp: cls.hp,
    ac: cls.ac, atkBonus: cls.atkBonus, dmgDice: cls.dmgDice,
    special: cls.special, specialKey: cls.specialKey,
    xp: 0, level: 1,
    specialUsed: false,
    advantageNext: false,
    bonusAtk: 0,
  });

  const hpBar = (hp, max) => {
    const pct = Math.max(0, hp / max);
    const filled = Math.round(pct * 20);
    const color = pct > 0.5 ? PALETTE.fg : pct > 0.25 ? PALETTE.gold : PALETTE.red;
    return `  HP [${("█".repeat(filled) + "░".repeat(20-filled))}] ${hp}/${max}`;
  };

  const rollAttack = (atkBonus, advantage = false) => {
    const r1 = d20(), r2 = d20();
    const roll_val = advantage ? Math.max(r1,r2) : r1;
    return { roll: roll_val, total: roll_val + atkBonus, nat20: roll_val === 20, nat1: roll_val === 1 };
  };

  const rollDamage = (dice, bonus=0) => rollN(dice[0], dice[1]) + bonus;

  // ── ROOM ENTRY ────────────────────────────────────────────────────────────
  const enterRoom = (roomKey, p = player, inv = inventory, fl = flags) => {
    const r = ROOMS[roomKey];
    if (!r) return;
    setRoom(roomKey);
    const isVisit = visited.has(roomKey);
    setVisited(v => new Set([...v, roomKey]));

    push(``, `  ── ${r.name.toUpperCase()} ${"─".repeat(Math.max(0,46-r.name.length))}`, ``);
    r.desc.split("\n").forEach(l => push(`  ${l}`));
    push(``);

    // events on first visit
    if (!isVisit) {
      if (r.event && EVENTS[r.event]) {
        const evLines = EVENTS[r.event]();
        evLines.forEach(l => push(`  ✦ ${l}`));
        push(``);
        // origin_memory gives HP
        if (r.event === "origin_memory" && p) {
          setPlayer(prev => prev ? {...prev, hp: Math.min(prev.maxHp, prev.hp+2)} : prev);
        }
      }
    }

    // check for encounter
    if (r.encounter && !fl[`cleared_${roomKey}`]) {
      const mon = MONSTERS[r.encounter.monster];
      if (mon && Math.random() < r.encounter.chance) {
        // class passives
        let enemyHp = mon.hp;
        if (r.isBoss && p?.class === "Norse") {
          push(`  Your Norse lineage unsettles it. It hesitates.`);
        }
        push(
          `  `,
          `  ${mon.symbol} ${mon.name.toUpperCase()} appears!`,
          `  "${mon.flavor}"`,
          `  CR ${mon.cr} — HP: ${enemyHp}  AC: ${mon.ac}`,
          `  Special: ${mon.special}`,
          ``,
          `  Commands: ATTACK  SPECIAL  FLEE  ISA [type]  USE [item]`,
          ``,
        );
        setCombat({ key: r.encounter.monster, enemy: mon, enemyHp, round: 1, stunned: false, advantage: fl.odinBlessing || false, perlinBonus: 0 });
        setFlags(f => ({...f, odinBlessing: false}));
        setPhase("combat");
        return;
      }
    }

    // loot on first visit
    if (!isVisit && r.loot) {
      const item = ITEMS.find(i => i.id === r.loot.item);
      if (item && Math.random() < r.loot.chance) {
        push(`  You find: ${item.name} — ${item.desc}`);
        setInv(prev => [...prev, item]);
      }
    }

    if (fl[`cleared_${roomKey}`] && r.blockedUntilClear) {
      push(`  The path forward is now clear.`);
    }

    setPhase("explore");
  };

  // ── COMBAT ROUND ──────────────────────────────────────────────────────────
  const doCombat = (action, arg, p, cb) => {
    if (!cb) return;
    const { enemy, enemyHp, round, stunned, advantage } = cb;
    let newEnemyHp = enemyHp;
    let newCb = { ...cb, round: round+1, stunned: false, advantage: false };
    let newPlayer = { ...p };
    const lines_out = [`  ── ROUND ${round} ─────────────────────────────────────`];

    if (action === "attack" || action === "a") {
      const atk = rollAttack(p.atkBonus + (p.bonusAtk||0), advantage || p.advantageNext);
      newPlayer.advantageNext = false;
      newPlayer.bonusAtk = 0;
      if (atk.nat1) {
        lines_out.push(`  You attack — FUMBLE (rolled 1). The weapon slips.`);
      } else if (atk.nat20 || atk.total >= enemy.ac) {
        const dmg = rollDamage(p.dmgDice, atk.nat20 ? p.dmgDice[1] : 0);
        newEnemyHp -= dmg;
        lines_out.push(`  You attack — HIT! (${atk.roll}+${p.atkBonus} = ${atk.total} vs AC ${enemy.ac})`);
        lines_out.push(`  Damage: ${dmg}${atk.nat20?" (CRITICAL!)":""}`);
        lines_out.push(`  ${enemy.name} HP: ${Math.max(0, newEnemyHp)}/${enemy.hp}`);
      } else {
        lines_out.push(`  You attack — MISS (${atk.roll}+${p.atkBonus} = ${atk.total} vs AC ${enemy.ac})`);
      }
    }

    else if (action === "special" || action === p.specialKey) {
      if (p.specialUsed && !["inspire"].includes(p.specialKey)) {
        lines_out.push(`  Special already used this combat.`);
      } else {
        lines_out.push(`  You use: ${p.special}`);
        if (p.specialKey === "vanish") {
          newPlayer.advantageNext = true;
          lines_out.push(`  Next attack: ADVANTAGE.`);
        } else if (p.specialKey === "reckless") {
          const atk = rollAttack(p.atkBonus + 4);
          if (atk.total >= enemy.ac) {
            const dmg = rollDamage(p.dmgDice) * 2;
            newEnemyHp -= dmg;
            lines_out.push(`  Reckless HIT — ${dmg} damage (doubled)!`);
            // take damage next from enemy
          }
          lines_out.push(`  Warning: double damage from enemy this round.`);
          newCb.recklessRound = true;
        } else if (p.specialKey === "converge") {
          newCb.converge = true;
          lines_out.push(`  The Seeker must reroll its attack (takes worse).`);
        } else if (p.specialKey === "null") {
          newEnemyHp -= 0;
          newCb.stunned = true;
          lines_out.push(`  Null strike — ${enemy.name} is stunned. Skips its next attack.`);
        } else if (p.specialKey === "inspire") {
          const heal = rollN(1,6);
          newPlayer.hp = Math.min(p.maxHp, p.hp + heal);
          lines_out.push(`  You restore ${heal} HP.`);
        } else if (p.specialKey === "rewrite") {
          const heal = rollN(1,4);
          newPlayer.hp = Math.min(p.maxHp, p.hp + heal);
          lines_out.push(`  The room rewrites. You recover ${heal} HP.`);
        }
        newPlayer.specialUsed = true;
      }
    }

    else if (action === "isa") {
      const typeName = arg || "Void";
      lines_out.push(`  > getty isa: ${typeName}`);
      lines_out.push(`  You declare your nature.`);
      if (enemy.attracted && CLASSES[typeName]?.nature === enemy.attracted) {
        // monster drawn in — high risk
        lines_out.push(`  ${enemy.name} is attracted to that nature.`);
        lines_out.push(`  It lunges — but the declaration forces it to reveal itself.`);
        const dmg = rollDamage(p.dmgDice, 2);
        newEnemyHp -= dmg;
        lines_out.push(`  You exploit the opening: ${dmg} damage.`);
      } else {
        // confuses most enemies
        newCb.stunned = true;
        lines_out.push(`  The declaration confuses ${enemy.name}. It hesitates. Stunned.`);
      }
    }

    else if (action === "use") {
      const item = inventory.find(i => i.id === arg || i.name.toLowerCase().includes(arg||""));
      if (!item) { lines_out.push(`  No such item.`); }
      else {
        lines_out.push(`  You use: ${item.name}`);
        if (item.use === "hp") {
          const heal = Array.isArray(item.val) ? rollN(item.val[0],item.val[1])+item.val[2] : item.val;
          newPlayer.hp = Math.min(p.maxHp, p.hp + heal);
          lines_out.push(`  Restored ${heal} HP.`);
        } else if (item.use === "atk") {
          newPlayer.bonusAtk = (newPlayer.bonusAtk||0) + item.val;
          lines_out.push(`  +${item.val} attack this round.`);
        } else if (item.use === "stun") {
          newCb.stunned = true;
          lines_out.push(`  ${enemy.name} is stunned this round.`);
        } else if (item.use === "adv") {
          newPlayer.advantageNext = true;
          lines_out.push(`  Advantage on next attack.`);
        }
        setInv(prev => prev.filter(i => i.id !== item.id));
      }
    }

    else if (action === "flee" || action === "f") {
      const flee = d20();
      if (flee >= 10) {
        lines_out.push(`  You flee! (${flee}) — escaping back the way you came.`);
        push(...lines_out);
        setCombat(null);
        setPhase("explore");
        const r = ROOMS[room];
        const back = r.exits?.back || r.exits?.forward;
        if (back) enterRoom(back, newPlayer);
        return;
      } else {
        lines_out.push(`  Flee failed (${flee}) — blocked.`);
      }
    }

    // ── ENEMY TURN ────────────────────────────────────────────────────────
    if (newEnemyHp > 0 && action !== "flee") {
      if (newCb.stunned) {
        lines_out.push(`  ${enemy.name} is stunned — skips its attack.`);
      } else {
        let enemyAtk = rollAttack(enemy.atkBonus);
        if (newCb.converge) { const r2 = rollAttack(enemy.atkBonus); enemyAtk = { ...enemyAtk, total: Math.min(enemyAtk.total, r2.total) }; newCb.converge = false; }
        const bonus = p.class === "Norse" && cb.key === "RootWatcher" ? -2 : 0;
        if (enemyAtk.total + bonus >= p.ac) {
          let dmg = rollN(enemy.dmg[0], enemy.dmg[1]);
          if (newCb.recklessRound) dmg *= 2;
          // boss special
          if (cb.key === "RootWatcher" && round % 3 === 0) {
            const surge = rollN(2,10);
            lines_out.push(`  ROOT SURGE — ${enemy.name} channels the root: ${surge} damage!`);
            newPlayer.hp = Math.max(0, newPlayer.hp - surge);
          }
          newPlayer.hp = Math.max(0, newPlayer.hp - dmg);
          lines_out.push(`  ${enemy.name} HITS you (${enemyAtk.roll}+${enemy.atkBonus} = ${enemyAtk.total} vs AC ${p.ac}) — ${dmg} damage.`);
          // drain special
          if (cb.key === "VoidCrawler" && Math.random() < 0.3) {
            newPlayer.ac = Math.max(8, newPlayer.ac - 1);
            lines_out.push(`  DRAIN — your AC drops to ${newPlayer.ac}.`);
          }
          // reflect
          if (cb.key === "MirrorWalker" && Math.random() < 0.25 && action === "attack") {
            const ref = rollN(1,4);
            newPlayer.hp = Math.max(0, newPlayer.hp - ref);
            lines_out.push(`  REFLECT — ${ref} damage reflected back at you!`);
          }
        } else {
          lines_out.push(`  ${enemy.name} MISSES you (${enemyAtk.roll}+${enemy.atkBonus} = ${enemyAtk.total} vs AC ${p.ac}).`);
        }
        // clock haste
        if (cb.key === "Clock" && roll(20) >= 15) {
          const d = rollN(1,6);
          newPlayer.hp = Math.max(0, newPlayer.hp - d);
          lines_out.push(`  HASTE — second attack: ${d} damage!`);
        }
      }
      newCb.recklessRound = false;
    }

    lines_out.push(``, hpBar(newPlayer.hp, newPlayer.maxHp), ``);

    // ── OUTCOME ────────────────────────────────────────────────────────────
    if (newPlayer.hp <= 0) {
      lines_out.push(`  You fall.`, `  The root does not catch you.`, `  GAME OVER — type RESTART to begin again.`);
      push(...lines_out);
      setCombat(null);
      setPlayer(newPlayer);
      setPhase("gameover");
      return;
    }

    if (newEnemyHp <= 0) {
      lines_out.push(`  ${enemy.name} is defeated!`);
      const xpGain = enemy.xp;
      newPlayer.xp += xpGain;
      if (newPlayer.xp >= newPlayer.level * 100) { newPlayer.level++; newPlayer.maxHp += 5; newPlayer.hp = Math.min(newPlayer.maxHp, newPlayer.hp+5); lines_out.push(`  LEVEL UP! Now level ${newPlayer.level}. Max HP +5.`); }
      lines_out.push(`  XP gained: ${xpGain}  Total: ${newPlayer.xp}`);

      // room loot on clear
      const r = ROOMS[room];
      if (r.loot && Math.random() < r.loot.chance) {
        const item = ITEMS.find(i => i.id === r.loot.item);
        if (item) { lines_out.push(`  Loot: ${item.name} — ${item.desc}`); setInv(prev => [...prev, item]); }
      }
      push(...lines_out);
      setCombat(null);
      setPlayer(newPlayer);
      setFlags(f => ({...f, [`cleared_${room}`]: true}));
      // boss victory
      if (cb.key === "RootWatcher") {
        push(``, `  ╔══════════════════════════════════════════════════════╗`,
          `  ║                  VICTORY                            ║`,
          `  ║  The Root Watcher falls.                            ║`,
          `  ║  The root holds — but you held longer.              ║`,
          `  ║  v0.9. The route was reached.                       ║`,
          `  ║  DOGECOIN = 1. It was always 1.                     ║`,
          `  ╚══════════════════════════════════════════════════════╝`
        );
        setPhase("victory");
        return;
      }
      setPhase("explore");
      return;
    }

    push(...lines_out);
    setCombat({...newCb, enemyHp: newEnemyHp});
    setPlayer(newPlayer);
  };

  // ── COMMAND HANDLING ──────────────────────────────────────────────────────
  const handleCommand = (raw) => {
    const t = raw.trim().toLowerCase();
    const parts = t.split(/\s+/);
    const cmd = parts[0];
    const arg = parts.slice(1).join(" ");

    push(``, `  > ${raw}`);

    // ── CLASS SELECTION ────────────────────────────────────────────────────
    if (phase === "class") {
      const key = Object.keys(CLASSES).find(k => k.toLowerCase() === t);
      if (key) {
        const cls = CLASSES[key];
        const p = makePlayer(cls);
        setPlayer(p);
        push(
          ``,
          `  You are ${cls.title}.`,
          `  "${cls.flavor}"`,
          ``,
          `  HP: ${p.hp}  AC: ${p.ac}  ATK: +${p.atkBonus}`,
          `  Special: ${p.special}`,
          `  Passive: ${cls.passiveNote}`,
          ``,
          `  The shell opens.`,
          `  The dungeon begins.`,
          ``,
        );
        setPhase("entering");
        setTimeout(() => enterRoom("entrance", p, [], {}), 300);
      } else {
        push(`  Unknown class. Choose: ${Object.keys(CLASSES).join("  ")}`);
      }
      return;
    }

    // ── GAMEOVER ──────────────────────────────────────────────────────────
    if (phase === "gameover" || phase === "victory") {
      if (cmd === "restart") {
        setLines([]);
        setPhase("class");
        setPlayer(null);
        setRoom("entrance");
        setVisited(new Set());
        setCombat(null);
        setInv([]);
        setFlags({});
        push(
          `  Choose your class.`, ``,
          ...Object.entries(CLASSES).map(([k,v]) => `  ${k.padEnd(14)} — ${v.flavor}`),
          ``,
        );
      }
      return;
    }

    // ── COMBAT MODE ───────────────────────────────────────────────────────
    if (phase === "combat") {
      if (!player || !combat) return;
      if (cmd === "help") {
        push(`  ATTACK (a)  SPECIAL (${player.specialKey})  FLEE (f)  USE [item]  ISA [Type]  STATS  INVENTORY (i)`);
        return;
      }
      if (cmd === "stats") { push(hpBar(player.hp, player.maxHp), `  Class: ${player.class}  Level: ${player.level}  AC: ${player.ac}  ATK: +${player.atkBonus}  XP: ${player.xp}`); return; }
      if (cmd === "inventory" || cmd === "i") { push(inventory.length ? `  Inventory: ${inventory.map(i=>i.name).join(", ")}` : `  Inventory empty.`); return; }
      doCombat(cmd, arg, player, combat);
      return;
    }

    // ── EXPLORE MODE ──────────────────────────────────────────────────────
    if (phase === "explore") {
      if (cmd === "help") {
        push(`  LOOK (l)  GO [direction]  STATS  INVENTORY (i)  USE [item]  MAP`);
        return;
      }
      if (cmd === "look" || cmd === "l") {
        const r = ROOMS[room];
        r.desc.split("\n").forEach(l => push(`  ${l}`));
        return;
      }
      if (cmd === "map") {
        push(
          `  `,
          `  MEGETREMIA — KNOWN MAP`,
          `  `,
          `  [ENTRANCE] → [THE INBETWEEN]`,
          `                    ↙           ↘       ↓`,
          `               [WELL]      [BRANCHES]  [MIDGARD]`,
          `                               ↓            ↓`,
          `                          [ASGARD]    [ROOT APPROACH]`,
          `                            ↓               ↓`,
          `                       [ROOT APPROACH] → [THE ROOT]`,
          `  `,
          `  Side: NIFLHEIM (locked — requires key)`,
          `  `,
          `  Visited: ${[...visited].map(r=>ROOMS[r]?.name||r).join("  ")||"none"}`,
        );
        return;
      }
      if (cmd === "stats") {
        if (!player) return;
        push(
          hpBar(player.hp, player.maxHp),
          `  Class: ${player.class}  Level: ${player.level}  XP: ${player.xp}`,
          `  AC: ${player.ac}  ATK: +${player.atkBonus}  Special: ${player.special}`,
        );
        return;
      }
      if (cmd === "inventory" || cmd === "i") {
        push(inventory.length ? `  ${inventory.map(i=>`${i.name} — ${i.desc}`).join("\n  ")}` : `  Inventory empty.`);
        return;
      }
      if (cmd === "use") {
        const item = inventory.find(i => i.id === arg || i.name.toLowerCase().includes(arg));
        if (!item) { push(`  No such item.`); return; }
        if (item.use === "hp") {
          const heal = Array.isArray(item.val) ? rollN(item.val[0],item.val[1])+item.val[2] : item.val;
          setPlayer(p => p ? {...p, hp: Math.min(p.maxHp, p.hp+heal)} : p);
          setInv(prev => prev.filter(i => i.id !== item.id));
          push(`  ${item.name}: restored ${heal} HP.`);
        } else { push(`  ${item.name} can only be used in combat.`); }
        return;
      }
      if (cmd === "drink" && room === "well") {
        const bonus = roll(6);
        setPlayer(p => p ? {...p, hp: Math.min(p.maxHp, p.hp+bonus)} : p);
        push(`  You drink from the well. Restored ${bonus} HP.`, `  Something shifts in your understanding. +1 to next INT check.`);
        return;
      }
      if (cmd === "go") {
        const r = ROOMS[room];
        const dir = arg;
        const dest = r.exits?.[dir];
        if (!dest) { push(`  No exit that way. Available: ${Object.keys(r.exits||{}).join("  ")}`); return; }
        if (r.lockedExit === dir) {
          if (!inventory.find(i=>i.id==="megetremia_key")) { push(`  Locked. You need the Megetremia Key.`); return; }
          setInv(prev => prev.filter(i=>i.id!=="megetremia_key"));
          push(`  You use the key. The passage opens.`);
        }
        if (dest === "victory") { push(`  There is nothing beyond.`); return; }
        enterRoom(dest, player, inventory, flags);
        return;
      }
      if (cmd === "north"||cmd === "south"||cmd === "east"||cmd === "west"||cmd === "forward"||cmd === "back"||cmd === "left"||cmd === "right"||cmd === "descend") {
        const r = ROOMS[room];
        const dest = r.exits?.[cmd];
        if (!dest) { push(`  Can't go that way. Available: ${Object.keys(r.exits||{}).join("  ")}`); return; }
        enterRoom(dest, player, inventory, flags);
        return;
      }
      push(`  Unknown command. Type HELP.`);
    }
  };

  const handleKey = (e) => {
    if (e.key === "Enter") {
      const v = input;
      setInput("");
      if (v.trim()) handleCommand(v);
    }
  };

  // ── RENDER ────────────────────────────────────────────────────────────────
  const col = (line) => {
    if (line.includes("HITS you")||line.includes("damage")||line.includes("ROOT SURGE")||line.includes("GAME OVER")) return PALETTE.red;
    if (line.includes("HIT!")||line.includes("LEVEL UP")||line.includes("VICTORY")||line.includes("defeated")) return PALETTE.gold;
    if (line.includes("> ")||line.includes("You use")||line.includes("You attack")||line.includes("You flee")) return PALETTE.bright;
    if (line.includes("MISS")||line.includes("FUMBLE")||line.includes("stunned")) return PALETTE.dim;
    if (line.includes("╔")||line.includes("║")||line.includes("╚")||line.includes("──")) return PALETTE.gold;
    if (line.includes("Perrin:")) return "#aaddaa";
    if (line.includes("▓")||line.includes("◷")||line.includes("◈")||line.includes("◉")||line.includes("⊕")) return PALETTE.boss;
    if (line.includes("✦")) return PALETTE.blue;
    if (line.includes("HP [")||line.includes("XP:")||line.includes("AC:")) return PALETTE.system;
    return PALETTE.fg;
  };

  return (
    <div style={{ minHeight:"100vh", background:PALETTE.bg, fontFamily:"'Courier New',Courier,monospace", fontSize:13, lineHeight:1.9 }}
      onClick={() => inputRef.current?.focus()}>
      <style>{`::-webkit-scrollbar{width:2px} ::-webkit-scrollbar-thumb{background:#33443320} ::selection{background:#ccaa4433}`}</style>
      <div style={{ padding:"24px 24px 100px" }}>
        {lines.map((line, i) => (
          <div key={i} style={{ color: col(line), whiteSpace:"pre-wrap", wordBreak:"break-word" }}>
            {line || "\u00a0"}
          </div>
        ))}
        {(phase !== "gameover" && phase !== "victory" && phase !== "class") && (
          <div style={{ display:"flex", alignItems:"center", marginTop:4 }}>
            <span style={{ color:PALETTE.prompt, marginRight:8 }}>{">"}</span>
            <input
              ref={inputRef} value={input}
              onChange={e => setInput(e.target.value)}
              onKeyDown={handleKey}
              autoComplete="off" autoCorrect="off" autoCapitalize="none" spellCheck={false}
              style={{ background:"none", border:"none", outline:"none", color:PALETTE.prompt, fontFamily:"inherit", fontSize:"inherit", flex:1, caretColor:PALETTE.prompt, minWidth:0 }}
            />
          </div>
        )}
        {(phase === "class") && (
          <div style={{ display:"flex", alignItems:"center", marginTop:4 }}>
            <span style={{ color:PALETTE.prompt, marginRight:8 }}>{">"}</span>
            <input
              ref={inputRef} value={input}
              onChange={e => setInput(e.target.value)}
              onKeyDown={handleKey}
              autoComplete="off" autoCorrect="off" autoCapitalize="none" spellCheck={false}
              style={{ background:"none", border:"none", outline:"none", color:PALETTE.prompt, fontFamily:"inherit", fontSize:"inherit", flex:1, caretColor:PALETTE.prompt, minWidth:0 }}
            />
          </div>
        )}
        {(phase === "gameover" || phase === "victory") && (
          <div style={{ display:"flex", alignItems:"center", marginTop:4 }}>
            <span style={{ color:PALETTE.dim, marginRight:8 }}>{">"}</span>
            <input
              ref={inputRef} value={input}
              onChange={e => setInput(e.target.value)}
              onKeyDown={handleKey}
              autoComplete="off" autoCorrect="off" autoCapitalize="none" spellCheck={false}
              style={{ background:"none", border:"none", outline:"none", color:PALETTE.dim, fontFamily:"inherit", fontSize:"inherit", flex:1, caretColor:PALETTE.dim, minWidth:0 }}
            />
          </div>
        )}
        <div ref={bottomRef} />
      </div>
    </div>
  );
}