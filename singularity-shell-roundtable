// ── DICE ─────────────────────────────────────────────────────────────────────
const roll = (sides) => Math.floor(Math.random() * sides) + 1;
const rollN = (n, sides) => Array.from({length:n}, () => roll(sides)).reduce((a,b)=>a+b,0);
const d20 = () => roll(20);
const d6  = () => roll(6);

